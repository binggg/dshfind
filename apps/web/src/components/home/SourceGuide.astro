---
/**
 * 首页「把 dshfind 加为 DSH 插件索引源」引导（老站 sections/plugin-source-guide.tsx 的 Astro 版）。
 *
 * DSH v0.2.1-alpha.4 起支持自定义插件索引源（插件 → 发现 → 添加索引源），但 DSH 不内置任何源。
 * 索引本体由 scripts/lib/dsh-index.mjs 生成、api-edge Worker 的 /market/dsh-index.json 提供。
 * 演示动画复用老站的纯 SVG 组件（服务端渲染、零 JS）；复制按钮是几行原生脚本。
 */
import {
  DSH_INDEX_URL,
  PluginSourceDemo,
  type PluginSourceDemoLabels,
} from "@/components/sections/plugin-source-demo";
import { translator, type Locale } from "~/i18n";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = translator(locale);
const labels = t.raw<PluginSourceDemoLabels>("SourceGuide.demo");
const steps = t.raw<{ title: string; body: string }[]>("SourceGuide.steps");

// lucide 图标路径：BadgeCheck / RefreshCw / Sparkles
const SPARKLES = '<path d="M9.937 15.5A2 2 0 0 0 8.5 14.063l-6.135-1.582a.5.5 0 0 1 0-.962L8.5 9.936A2 2 0 0 0 9.937 8.5l1.582-6.135a.5.5 0 0 1 .963 0L14.063 8.5A2 2 0 0 0 15.5 9.937l6.135 1.581a.5.5 0 0 1 0 .964L15.5 14.063a2 2 0 0 0-1.437 1.437l-1.582 6.135a.5.5 0 0 1-.963 0z"/>';
const perks = [
  {
    icon: '<path d="M3.85 8.62a4 4 0 0 1 4.78-4.77 4 4 0 0 1 6.74 0 4 4 0 0 1 4.78 4.78 4 4 0 0 1 0 6.74 4 4 0 0 1-4.77 4.78 4 4 0 0 1-6.75 0 4 4 0 0 1-4.78-4.77 4 4 0 0 1 0-6.76Z"/><path d="m9 12 2 2 4-4"/>',
    text: t("SourceGuide.perkVerified"),
  },
  {
    icon: '<path d="M3 12a9 9 0 0 1 9-9 9.75 9.75 0 0 1 6.74 2.74L21 8"/><path d="M21 3v5h-5"/><path d="M21 12a9 9 0 0 1-9 9 9.75 9.75 0 0 1-6.74-2.74L3 16"/><path d="M8 16H3v5"/>',
    text: t("SourceGuide.perkDaily"),
  },
  { icon: SPARKLES, text: t("SourceGuide.perkPicks") },
];
---

<section class="mx-auto w-full max-w-6xl px-4 pt-4 pb-10 sm:px-6 sm:pt-6">
  <div class="relative overflow-hidden rounded-2xl border border-brand-500/30 bg-gradient-to-br from-brand-500/10 via-card to-card p-6 sm:p-8 dark:from-brand-500/15">
    <div class="pointer-events-none absolute -top-24 -right-24 size-72 rounded-full bg-brand-500/15 blur-3xl"></div>
    <div class="relative grid gap-8 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.15fr)] lg:items-center">
      <div>
        <span class="inline-flex items-center gap-1.5 rounded-full bg-brand-500 px-3 py-1 text-xs font-semibold text-white shadow-sm">
          <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={SPARKLES} />
          {t("SourceGuide.badge")}
        </span>
        <h2 class="mt-4 text-2xl font-bold tracking-tight sm:text-3xl">{t("SourceGuide.title")}</h2>
        <p class="mt-3 max-w-[56ch] text-sm leading-relaxed text-muted-foreground sm:text-base">{t("SourceGuide.subtitle")}</p>

        <div class="mt-5 rounded-xl border border-brand-500/40 bg-background/80 p-3 shadow-sm">
          <div class="mb-1.5 flex items-center gap-1.5 text-xs font-medium text-muted-foreground">
            <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M9 17H7A5 5 0 0 1 7 7h2" /><path d="M15 7h2a5 5 0 1 1 0 10h-2" /><line x1="8" x2="16" y1="12" y2="12" /></svg>
            {t("SourceGuide.urlLabel")}
          </div>
          <div class="flex items-center gap-2">
            <code class="min-w-0 flex-1 truncate font-mono text-sm font-semibold text-brand-600 select-all dark:text-brand-300">{DSH_INDEX_URL}</code>
            <button
              type="button"
              data-source-copy={DSH_INDEX_URL}
              data-copied-label={t("SourceGuide.copied")}
              class="group inline-flex shrink-0 items-center gap-1.5 rounded-md border border-border/60 px-2.5 py-1 text-xs font-medium transition-colors hover:bg-muted"
            >
              <svg class="size-3.5 group-data-copied:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect width="14" height="14" x="8" y="8" rx="2" ry="2" /><path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2" /></svg><svg class="hidden size-3.5 text-emerald-500 group-data-copied:block" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M20 6 9 17l-5-5" /></svg><span data-copy-label>{t("SourceGuide.copy")}</span>
            </button>
          </div>
        </div>

        <ol class="mt-5 space-y-3">
          {
            steps.map((step, i) => (
              <li class="flex gap-3">
                <span class="flex size-6 shrink-0 items-center justify-center rounded-full bg-brand-500 text-xs font-bold text-white">{i + 1}</span>
                <div class="text-sm leading-relaxed">
                  <span class="font-semibold">{step.title}</span>
                  <span class="text-muted-foreground"> — {step.body}</span>
                </div>
              </li>
            ))
          }
        </ol>

        <ul class="mt-5 flex flex-wrap gap-2">
          {
            perks.map((perk) => (
              <li class="inline-flex items-center gap-1.5 rounded-full border border-border/60 bg-background/60 px-2.5 py-1 text-xs font-medium">
                <svg class="size-3.5 text-brand-600 dark:text-brand-300" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" set:html={perk.icon} />
                {perk.text}
              </li>
            ))
          }
        </ul>
      </div>

      <PluginSourceDemo labels={labels} />
    </div>
  </div>
</section>

<script>
  // 复制索引 URL：失败静默——URL 本身可选中，用户手动复制即可
  document.querySelectorAll<HTMLButtonElement>("[data-source-copy]").forEach((btn) => {
    const label = btn.querySelector("[data-copy-label]");
    const original = label?.textContent ?? "";
    let timer: ReturnType<typeof setTimeout> | undefined;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.sourceCopy ?? "");
        if (label) label.textContent = btn.dataset.copiedLabel ?? "";
        btn.toggleAttribute("data-copied", true);
        clearTimeout(timer);
        timer = setTimeout(() => {
          if (label) label.textContent = original;
          btn.toggleAttribute("data-copied", false);
        }, 1800);
      } catch {}
    });
  });
</script>
